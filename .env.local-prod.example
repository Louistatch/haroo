# ============================================
# Haroo - Configuration Production Locale (Docker)
# Simule la prod sans HTTPS
# ============================================

# Django
DJANGO_SETTINGS_MODULE=
DEBUG=
SECRET_KEY=
ENCRYPTION_KEY=

# Domaine local
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
FRONTEND_URL=

# Base de données PostgreSQL (PostGIS via Docker)
USE_SQLITE=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Redis
REDIS_URL=
REDIS_CACHE_URL=
REDIS_HOST=
REDIS_PORT=

# Celery
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Stockage Supabase
USE_S3=False
USE_CLOUDINARY=
USE_SUPABASE=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=

# FedaPay (sandbox pour tests)
FEDAPAY_ENVIRONMENT=
FEDAPAY_API_KEY=
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=

# Email (console en local — les emails s'affichent dans les logs Docker)
EMAIL_BACKEND=
DEFAULT_FROM_EMAIL=

# JWT
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_LIFETIME=
JWT_REFRESH_TOKEN_LIFETIME=

# Commissions
COMMISSION_AGRONOME=
COMMISSION_PREVENTE=
COMMISSION_TRANSPORT=
SALAIRE_MINIMUM_HORAIRE=

# SMS
SMS_GATEWAY_SENDER_ID=
